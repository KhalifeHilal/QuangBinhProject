// Terrain-aware pipe-flux flooding: plug into TerrainFloodSimulation_Szenarien.cs.
// Solver heights and water depths share the same units in StateMap.
#pragma kernel Initialize
#pragma kernel AddWater
#pragma kernel ComputeFlux
#pragma kernel ApplyFlux
#pragma kernel UpdateVelocity

RWTexture2D<float4> StateMap;
RWTexture2D<float4> FluxMap;
RWTexture2D<float2> VelocityMap;
Texture2D<float> ObstacleMap;
Texture2D<float> RiverMask;
Texture2D<float> TerrainHeightMap;
uint _Width, _Height;
float _DeltaTime, _Gravity, _PipeArea, _PipeLength, _CellArea, _RainRate, _Evaporation, _MaximumWater;
float _DryThreshold, _MaximumVelocity;
float2 _CellSize;
float _RiverCenter, _RiverHalfWidth, _RiverDepth, _RiverInflow;
int _VisibleLeftStartReservoir;
int _OneWayFlow;
int _OpenDownstreamBoundary;
int _SourceMode;               // 0 = river inlet, 1 = local point source, 2 = rain only
int _CarveRiver;               // set only if the mesh does not already have a channel
float2 _PointSourceUV;
float _PointSourceRadius;

uint2 ClampCell(int2 p) { return (uint2)clamp(p, int2(0, 0), int2((int)_Width-1, (int)_Height-1)); }
float FullHeight(int2 p) { float4 s = StateMap[ClampCell(p)]; return s.r + s.g; }
float GroundHeight(int2 p) { return StateMap[ClampCell(p)].r; }
bool IsBlocked(int2 p) { return ObstacleMap[ClampCell(p)] > 0.5; }

[numthreads(8,8,1)]
void Initialize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    float inRiver = RiverMask[id.xy];
    float terrain = TerrainHeightMap[id.xy] - (_CarveRiver != 0 ? _RiverDepth * inRiver : 0.0);
    if (IsBlocked(id.xy))
    {
        StateMap[id.xy] = float4(terrain, 0, 0, 1);
        FluxMap[id.xy] = 0;
        VelocityMap[id.xy] = 0;
        return;
    }
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);
    float visibleLeftReservoir = 1.0 - smoothstep(0.04, 0.14, uv.x);
    float water = (_SourceMode == 0 && _VisibleLeftStartReservoir != 0)
        ? 0.18 * inRiver * visibleLeftReservoir : 0.0;
    StateMap[id.xy] = float4(terrain, water, 0, 1);
    FluxMap[id.xy] = 0;
    VelocityMap[id.xy] = 0;
}

[numthreads(8,8,1)]
void AddWater(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    if (IsBlocked(id.xy))
    {
        float4 blockedState = StateMap[id.xy];
        blockedState.g = 0;
        StateMap[id.xy] = blockedState;
        VelocityMap[id.xy] = 0;
        return;
    }
    float4 state = StateMap[id.xy];
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);
    float narrowInlet = 1.0 - smoothstep(0.005, 0.025, uv.x);
    float visibleInlet = 1.0 - smoothstep(0.025, 0.08, uv.x);
    float leftInlet = _VisibleLeftStartReservoir != 0 ? visibleInlet : narrowInlet;
    float riverSource = RiverMask[id.xy] * leftInlet;
    float pointDist = length(uv - _PointSourceUV);
    float pointSource = 1.0 - smoothstep(_PointSourceRadius * 0.55,
                                         max(_PointSourceRadius, 0.001), pointDist);
    float sourceMask = _SourceMode == 0 ? riverSource : (_SourceMode == 1 ? pointSource : 0.0);
    float source = _RainRate + _RiverInflow * sourceMask;
    state.g = clamp(state.g + source * _DeltaTime, 0, _MaximumWater);
    StateMap[id.xy] = state;
}

[numthreads(8,8,1)]
void ComputeFlux(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    if (IsBlocked(id.xy)) { FluxMap[id.xy] = 0; VelocityMap[id.xy] = 0; return; }
    int2 p = int2(id.xy);
    float4 state = StateMap[id.xy];
    float total = state.r + state.g;
    float4 neighboringSurface = float4(FullHeight(p+int2(-1,0)), FullHeight(p+int2(1,0)),
                                        FullHeight(p+int2(0,1)), FullHeight(p+int2(0,-1)));
    float4 difference = total - neighboringSurface;
    float4 oldFlux = FluxMap[id.xy];
    float4 flux = max(0.0, oldFlux + _DeltaTime * _Gravity * _PipeArea * difference / max(_PipeLength, 1e-6));

    // Do not push water into higher, currently dry ground; wait for overtopping.
    float4 bed = float4(GroundHeight(p+int2(-1,0)), GroundHeight(p+int2(1,0)),
                        GroundHeight(p+int2(0,1)), GroundHeight(p+int2(0,-1)));
    if (total <= bed.x + _DryThreshold) flux.x = 0;
    if (total <= bed.y + _DryThreshold) flux.y = 0;
    if (total <= bed.z + _DryThreshold) flux.z = 0;
    if (total <= bed.w + _DryThreshold) flux.w = 0;

    if (_OneWayFlow != 0) flux.x = 0;
    if (id.x == 0) flux.x = 0;
    if (id.y == _Height-1) flux.z = 0;
    if (id.y == 0) flux.w = 0;

    // Genuine outflow: the right-boundary flux exits the tile and counts in
    // the volume conservation equation. We never arbitrarily erase water cells.
    if (id.x == _Width-1)
    {
        if (_OpenDownstreamBoundary != 0)
            flux.y = max(0.0, oldFlux.y + _DeltaTime * _Gravity * _PipeArea * state.g / max(_PipeLength, 1e-6));
        else flux.y = 0;
    }

    if (IsBlocked(p+int2(-1,0))) flux.x = 0;
    if (id.x != _Width-1 && IsBlocked(p+int2(1,0))) flux.y = 0;
    if (IsBlocked(p+int2(0,1))) flux.z = 0;
    if (IsBlocked(p+int2(0,-1))) flux.w = 0;

    float sumFlux = flux.x + flux.y + flux.z + flux.w;
    if (sumFlux > 1e-8 && state.g > _DryThreshold)
        flux *= min(1.0, state.g * _CellArea / (sumFlux * _DeltaTime));
    else if (state.g <= _DryThreshold) flux = 0;
    FluxMap[id.xy] = flux;
}

[numthreads(8,8,1)]
void ApplyFlux(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    if (IsBlocked(id.xy))
    {
        float4 blockedState = StateMap[id.xy];
        blockedState.g = 0;
        StateMap[id.xy] = blockedState;
        return;
    }
    int2 p = int2(id.xy);
    float4 outgoing = FluxMap[id.xy];
    float incoming = FluxMap[ClampCell(p+int2(-1,0))].y
                   + FluxMap[ClampCell(p+int2(1,0))].x
                   + FluxMap[ClampCell(p+int2(0,1))].w
                   + FluxMap[ClampCell(p+int2(0,-1))].z;
    float4 state = StateMap[id.xy];
    float volumeDelta = incoming - outgoing.x - outgoing.y - outgoing.z - outgoing.w;
    state.g = clamp((state.g + _DeltaTime * volumeDelta / max(_CellArea, 1e-6))
                     * (1.0 - _Evaporation * _DeltaTime), 0, _MaximumWater);
    if (state.g <= _DryThreshold) state.g = 0;
    StateMap[id.xy] = state;

    float meanDepth = max(state.g, _DryThreshold);
    float flowX = FluxMap[ClampCell(p+int2(-1,0))].y - FluxMap[ClampCell(p+int2(1,0))].x;
    float flowZ = FluxMap[ClampCell(p+int2(0,1))].w - FluxMap[ClampCell(p+int2(0,-1))].z;
    VelocityMap[id.xy] = float2(flowX / max(meanDepth * _CellSize.y, 1e-6),
                                flowZ / max(meanDepth * _CellSize.x, 1e-6));
}

[numthreads(8,8,1)]
void UpdateVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height) return;
    if (IsBlocked(id.xy)) { VelocityMap[id.xy] = 0; return; }
    int2 p = int2(id.xy);
    if (StateMap[id.xy].g <= _DryThreshold) { VelocityMap[id.xy] = 0; return; }
    float etaL = FullHeight(p + int2(-1,0));
    float etaR = FullHeight(p + int2(1,0));
    float etaB = FullHeight(p + int2(0,-1));
    float etaT = FullHeight(p + int2(0,1));
    float2 gradient = float2((etaR - etaL) / max(2.0 * _CellSize.x, 1e-6),
                             (etaT - etaB) / max(2.0 * _CellSize.y, 1e-6));
    float2 velocity = VelocityMap[id.xy] - _Gravity * gradient * _DeltaTime;
    if (IsBlocked(p + int2(-1,0)) || IsBlocked(p + int2(1,0))) velocity.x = 0;
    if (IsBlocked(p + int2(0,-1)) || IsBlocked(p + int2(0,1))) velocity.y = 0;
    if (_OneWayFlow != 0) velocity.x = max(0, velocity.x);
    float speed = length(velocity);
    if (speed > _MaximumVelocity) velocity *= _MaximumVelocity / max(speed, 1e-6);
    VelocityMap[id.xy] = velocity;
}
